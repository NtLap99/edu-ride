{
  "name": "eduride-student-management",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --config vite.config.js",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" package.json README.md \"*.config.{js,cjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" package.json README.md \"*.config.{js,cjs,ts}\"",
    "lint": "eslint . --ext .ts,.tsx,.js,.cjs --max-warnings=0"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "antd": "^5.24.8",
    "firebase": "^10.14.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^16.18.126",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^1.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.40.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.5",
    "postcss": "^8.5.3",
    "prettier": "^2.8.8",
    "tailwindcss": "^3.4.17",
    "typescript": "~4.9.5",
    "vite": "^2.9.18"
  }
}
